<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_partner_landlord" model="res.partner">
            <field name="name">Landmark Properties Ltd</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_microsoft" model="res.partner">
            <field name="name">Microsoft Licensing</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_genset" model="res.partner">
            <field name="name">PowerCore Generators</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_isp" model="res.partner">
            <field name="name">FibreLink Networks</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_customer" model="res.partner">
            <field name="name">Bluewave Logistics</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_hardware" model="res.partner">
            <field name="name">Dell Enterprise Support</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_acme" model="res.partner">
            <field name="name">Acme Partners</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_cleaning" model="res.partner">
            <field name="name">SparkClean Services</field>
            <field name="is_company" eval="True"/>
        </record>
        <record id="demo_partner_insurer" model="res.partner">
            <field name="name">Sentinel Insurance</field>
            <field name="is_company" eval="True"/>
        </record>

        <!-- Template -->
        <record id="demo_contract_template" model="contract.radar">
            <field name="name">Standard SaaS subscription</field>
            <field name="is_template" eval="True"/>
            <field name="contract_type">license</field>
            <field name="billing_period">monthly</field>
            <field name="auto_renew" eval="True"/>
            <field name="notice_days">30</field>
            <field name="term_months">12</field>
            <field name="renewal_term_months">12</field>
            <field name="escalation_mode">fixed_percent</field>
            <field name="escalation_percent">5</field>
            <field name="escalation_every_months">12</field>
        </record>

        <!-- Cancel-by in ~30 days, fixed 8% yearly escalation -->
        <record id="demo_contract_lease" model="contract.radar">
            <field name="name">Head office lease - Ikeja</field>
            <field name="contract_type">lease</field>
            <field name="partner_id" ref="demo_partner_landlord"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=245)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=120)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">yearly</field>
            <field name="amount">6000000</field>
            <field name="auto_renew" eval="True"/>
            <field name="notice_days">90</field>
            <field name="escalation_mode">fixed_percent</field>
            <field name="escalation_percent">8</field>
            <field name="escalation_every_months">12</field>
            <field name="escalation_clause">Rent increases by 8% on each anniversary of the commencement date.</field>
            <field name="asset_ref">3rd floor, 14 Allen Avenue</field>
        </record>

        <record id="demo_contract_m365" model="contract.radar">
            <field name="name">Microsoft 365 licences</field>
            <field name="contract_type">license</field>
            <field name="partner_id" ref="demo_partner_microsoft"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">expiring</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=300)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=65)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">monthly</field>
            <field name="amount">450000</field>
            <field name="auto_renew" eval="True"/>
            <field name="notice_days">30</field>
            <field name="license_seats">120</field>
        </record>

        <!-- Urgent: cancel deadline in a few days -->
        <record id="demo_contract_genset" model="contract.radar">
            <field name="name">Generator maintenance plan</field>
            <field name="contract_type">service</field>
            <field name="partner_id" ref="demo_partner_genset"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">expiring</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=351)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=14)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">yearly</field>
            <field name="amount">1800000</field>
            <field name="auto_renew" eval="True"/>
            <field name="notice_days">10</field>
            <field name="asset_ref">500kVA diesel generator</field>
        </record>

        <record id="demo_contract_isp" model="contract.radar">
            <field name="name">Fibre internet - HQ</field>
            <field name="contract_type">vendor</field>
            <field name="partner_id" ref="demo_partner_isp"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=165)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=200)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">monthly</field>
            <field name="amount">280000</field>
            <field name="auto_renew" eval="True"/>
            <field name="notice_days">60</field>
            <field name="escalation_mode">scheduled</field>
        </record>
        <record id="demo_contract_isp_step1" model="contract.radar.escalation">
            <field name="contract_id" ref="demo_contract_isp"/>
            <field name="date" eval="(DateTime.today() + relativedelta(days=90)).strftime('%Y-%m-%d')"/>
            <field name="step_type">percent</field>
            <field name="value">10</field>
            <field name="note">Mid-term tariff adjustment</field>
        </record>

        <record id="demo_contract_customer" model="contract.radar">
            <field name="name">Logistics support retainer</field>
            <field name="contract_type">customer</field>
            <field name="partner_id" ref="demo_partner_customer"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">expiring</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=320)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=45)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">monthly</field>
            <field name="amount">1500000</field>
            <field name="auto_renew" eval="False"/>
            <field name="notice_days">30</field>
        </record>

        <record id="demo_contract_warranty" model="contract.radar">
            <field name="name">Server hardware warranty</field>
            <field name="contract_type">warranty</field>
            <field name="partner_id" ref="demo_partner_hardware"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">expiring</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=345)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=20)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">one_time</field>
            <field name="amount">900000</field>
            <field name="notice_days">0</field>
            <field name="asset_ref">PowerEdge R750 (x2)</field>
        </record>

        <record id="demo_contract_nda" model="contract.radar">
            <field name="name">Mutual NDA - Acme Partners</field>
            <field name="contract_type">nda</field>
            <field name="partner_id" ref="demo_partner_acme"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=700)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">one_time</field>
            <field name="amount">0</field>
        </record>

        <!-- Housekeeping flags: no owner and no end date -->
        <record id="demo_contract_cleaning" model="contract.radar">
            <field name="name">Office cleaning services</field>
            <field name="contract_type">vendor</field>
            <field name="partner_id" ref="demo_partner_cleaning"/>
            <field name="user_id" eval="False"/>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=400)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">monthly</field>
            <field name="amount">350000</field>
        </record>

        <record id="demo_contract_insurance" model="contract.radar">
            <field name="name">Executive insurance cover</field>
            <field name="contract_type">service</field>
            <field name="partner_id" ref="demo_partner_insurer"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="visibility">followers</field>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.today() - relativedelta(days=100)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.today() + relativedelta(days=265)).strftime('%Y-%m-%d')"/>
            <field name="billing_period">yearly</field>
            <field name="amount">4200000</field>
            <field name="auto_renew" eval="True"/>
            <field name="notice_days">45</field>
        </record>
    </data>
</odoo>
