<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cancellation_notice" model="ir.actions.report">
        <field name="name">Notice of Non-Renewal</field>
        <field name="model">contract.radar</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">contract_radar.report_cancellation_notice</field>
        <field name="report_file">contract_radar.report_cancellation_notice</field>
        <field name="print_report_name">'Notice - %s' % (object.reference or 'contract')</field>
    </record>

    <template id="report_cancellation_notice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="mb-4">
                            <div t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                        </div>
                        <p><span t-field="o.notice_sent_date"/></p>
                        <h4 class="mt-4 mb-4">
                            Notice of non-renewal: <span t-field="o.name"/>
                            <t t-if="o.external_ref"> (Ref. <span t-out="o.external_ref"/>)</t>
                        </h4>
                        <p>Dear Sir or Madam,</p>
                        <div t-field="o.notice_body"/>
                        <p class="mt-4">Yours faithfully,</p>
                        <p class="mt-5">
                            <strong t-out="o.env.user.name"/><br/>
                            <span t-out="o.company_id.name"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
