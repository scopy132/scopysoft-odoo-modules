<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contract_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Contract Summary: <span t-field="o.name"/></h2>
                        <p class="text-muted"><span t-field="o.reference"/> - <span t-field="o.contract_type"/> - <span t-field="o.state"/></p>

                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Counterparty</strong><br/>
                                <span t-field="o.partner_id"/>
                                <t t-if="o.external_ref"><br/><span class="text-muted">No. <span t-field="o.external_ref"/></span></t>
                            </div>
                            <div class="col-6">
                                <strong>Responsible / Backup</strong><br/>
                                <span t-field="o.user_id"/>
                                <t t-if="o.backup_user_id"> / <span t-field="o.backup_user_id"/></t>
                            </div>
                        </div>

                        <t t-if="o.alert_text">
                            <div class="alert alert-warning" role="alert"><strong><span t-field="o.alert_text"/></strong></div>
                        </t>

                        <table class="table table-sm">
                            <tbody>
                                <tr><th style="width:35%">Start date</th><td><span t-field="o.date_start"/></td></tr>
                                <tr><th>End date</th><td><span t-field="o.date_end"/></td></tr>
                                <tr><th>Notice period</th><td><span t-field="o.notice_days"/> days</td></tr>
                                <tr><th>Last day to cancel</th><td><strong><span t-field="o.date_cancel_by"/></strong></td></tr>
                                <tr><th>Auto-renew</th><td><t t-if="o.auto_renew">Yes (renewal term <span t-field="o.renewal_term_months"/> months)</t><t t-else="">No</t></td></tr>
                                <tr><th>Notice served</th><td><span t-field="o.notice_sent_date"/></td></tr>
                                <tr><th>Billing</th><td><span t-field="o.billing_period"/></td></tr>
                                <tr><th>Recurring amount</th><td><span t-field="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><th>Annual value</th><td><span t-field="o.annual_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><th>Cost of next term</th><td><span t-field="o.renewal_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><th>Projected total cost</th><td><span t-field="o.projected_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                <tr><th>Price escalation</th><td><span t-field="o.escalation_mode"/>
                                    <t t-if="o.escalation_mode == 'fixed_percent'"> (<span t-field="o.escalation_percent"/>% every <span t-field="o.escalation_every_months"/> months)</t></td></tr>
                            </tbody>
                        </table>

                        <t t-if="o.escalation_clause">
                            <h5>Price increase clause</h5>
                            <p><span t-field="o.escalation_clause"/></p>
                        </t>

                        <t t-if="o.escalation_ids">
                            <h5>Scheduled step-ups</h5>
                            <table class="table table-sm">
                                <thead><tr><th>Date</th><th>Type</th><th>Value</th><th>Resulting amount</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.escalation_ids" t-as="s">
                                        <td><span t-field="s.date"/></td>
                                        <td><span t-field="s.step_type"/></td>
                                        <td><span t-field="s.value"/></td>
                                        <td><span t-field="s.resulting_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="o.amendment_ids">
                            <h5>Amendments</h5>
                            <table class="table table-sm">
                                <thead><tr><th>Date</th><th>Title</th><th>Applied</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.amendment_ids" t-as="a">
                                        <td><span t-field="a.date"/></td>
                                        <td><span t-field="a.name"/></td>
                                        <td><t t-if="a.applied">Yes</t><t t-else="">No</t></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="o.terms">
                            <h5>Terms &amp; notes</h5>
                            <div t-field="o.terms"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
