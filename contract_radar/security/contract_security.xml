<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_contract_radar" model="ir.module.category">
        <field name="name">Contract Radar</field>
        <field name="description">Track contracts, deadlines, renewals and commitments.</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_contract_radar" model="res.groups.privilege">
        <field name="name">Contract Radar</field>
        <field name="category_id" ref="module_category_contract_radar"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_contract_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_contract_radar"/>
        <field name="comment">Can see contracts, the dashboard and the forecast. Cannot change anything.</field>
    </record>

    <record id="group_contract_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="privilege_id" ref="res_groups_privilege_contract_radar"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_viewer'))]"/>
        <field name="comment">Can create and edit contracts, price escalations and amendments.</field>
    </record>

    <record id="group_contract_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_contract_radar"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_finance'))]"/>
        <field name="comment">Full access, including deleting records, templates and configuration.</field>
    </record>

    <record id="group_contract_confidential" model="res.groups">
        <field name="name">Confidential Access</field>
        <field name="privilege_id" ref="res_groups_privilege_contract_radar"/>
        <field name="implied_ids" eval="[(4, ref('group_contract_viewer'))]"/>
        <field name="comment">Can see contracts marked as confidential, even when not responsible or following.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_contract_manager')), (4, ref('group_contract_confidential'))]"/>
    </record>
</odoo>
