<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Multi-company (global rules: apply to everybody) -->
    <record id="rule_contract_radar_company" model="ir.rule">
        <field name="name">Contract: multi-company</field>
        <field name="model_id" ref="model_contract_radar"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contract_radar_escalation_company" model="ir.rule">
        <field name="name">Contract step-up: multi-company</field>
        <field name="model_id" ref="model_contract_radar_escalation"/>
        <field name="domain_force">['|', ('contract_id.company_id', '=', False), ('contract_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contract_radar_amendment_company" model="ir.rule">
        <field name="name">Contract amendment: multi-company</field>
        <field name="model_id" ref="model_contract_radar_amendment"/>
        <field name="domain_force">['|', ('contract_id.company_id', '=', False), ('contract_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contract_radar_cost_line_company" model="ir.rule">
        <field name="name">Contract payment: multi-company</field>
        <field name="model_id" ref="model_contract_radar_cost_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contract_radar_reminder_log_company" model="ir.rule">
        <field name="name">Contract reminder log: multi-company</field>
        <field name="model_id" ref="model_contract_radar_reminder_log"/>
        <field name="domain_force">['|', ('contract_id.company_id', '=', False), ('contract_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_contract_radar_webhook_company" model="ir.rule">
        <field name="name">Contract webhook: multi-company</field>
        <field name="model_id" ref="model_contract_radar_webhook"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Confidential contracts: group rules are OR-ed, so Confidential Access sees everything -->
    <record id="rule_contract_radar_visibility" model="ir.rule">
        <field name="name">Contract: confidential only for responsible/followers</field>
        <field name="model_id" ref="model_contract_radar"/>
        <field name="groups" eval="[(4, ref('group_contract_viewer'))]"/>
        <field name="domain_force">['|', '|', '|', ('visibility', '=', 'all'), ('user_id', '=', user.id), ('backup_user_id', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_contract_radar_confidential_all" model="ir.rule">
        <field name="name">Contract: confidential access sees all</field>
        <field name="model_id" ref="model_contract_radar"/>
        <field name="groups" eval="[(4, ref('group_contract_confidential'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_contract_radar_escalation_visibility" model="ir.rule">
        <field name="name">Contract step-up: follows contract visibility</field>
        <field name="model_id" ref="model_contract_radar_escalation"/>
        <field name="groups" eval="[(4, ref('group_contract_viewer'))]"/>
        <field name="domain_force">['|', '|', '|', ('contract_id.visibility', '=', 'all'), ('contract_id.user_id', '=', user.id), ('contract_id.backup_user_id', '=', user.id), ('contract_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_contract_radar_escalation_confidential_all" model="ir.rule">
        <field name="name">Contract step-up: confidential access sees all</field>
        <field name="model_id" ref="model_contract_radar_escalation"/>
