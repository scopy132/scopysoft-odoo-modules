    </record>
    <record id="rule_contract_radar_amendment_confidential_all" model="ir.rule">
        <field name="name">Contract amendment: confidential access sees all</field>
        <field name="model_id" ref="model_contract_radar_amendment"/>
        <field name="groups" eval="[(4, ref('group_contract_confidential'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_contract_radar_cost_line_visibility" model="ir.rule">
        <field name="name">Contract payment: follows contract visibility</field>
        <field name="model_id" ref="model_contract_radar_cost_line"/>
        <field name="groups" eval="[(4, ref('group_contract_viewer'))]"/>
        <field name="domain_force">['|', '|', '|', ('contract_id.visibility', '=', 'all'), ('contract_id.user_id', '=', user.id), ('contract_id.backup_user_id', '=', user.id), ('contract_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_contract_radar_cost_line_confidential_all" model="ir.rule">
        <field name="name">Contract payment: confidential access sees all</field>
        <field name="model_id" ref="model_contract_radar_cost_line"/>
        <field name="groups" eval="[(4, ref('group_contract_confidential'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_contract_radar_reminder_log_visibility" model="ir.rule">
        <field name="name">Contract reminder log: follows contract visibility</field>
        <field name="model_id" ref="model_contract_radar_reminder_log"/>
        <field name="groups" eval="[(4, ref('group_contract_viewer'))]"/>
        <field name="domain_force">['|', '|', '|', ('contract_id.visibility', '=', 'all'), ('contract_id.user_id', '=', user.id), ('contract_id.backup_user_id', '=', user.id), ('contract_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_contract_radar_reminder_log_confidential_all" model="ir.rule">
        <field name="name">Contract reminder log: confidential access sees all</field>
        <field name="model_id" ref="model_contract_radar_reminder_log"/>
        <field name="groups" eval="[(4, ref('group_contract_confidential'))]"/>
