<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <div t-name="contract_radar.Dashboard" class="o_action o_contract_radar_dashboard">
        <Layout display="{ controlPanel: {} }">
            <t t-set-slot="control-panel-create-button">
                <button class="btn btn-primary" t-on-click="onRefresh">Refresh</button>
            </t>

            <div class="o_cr_body p-3" t-if="state.data">
                <div class="o_cr_kpis">
                    <t t-foreach="state.data.expiring" t-as="kpi" t-key="kpi.key">
                        <div class="o_cr_card" t-on-click="() => this.openList(kpi.title, kpi.domain)">
                            <div class="o_cr_card_label" t-esc="kpi.title"/>
                            <div class="o_cr_card_number" t-esc="kpi.count"/>
                            <div class="o_cr_card_sub"><t t-esc="kpi.value"/> annual cost</div>
                        </div>
                    </t>
                    <div class="o_cr_card" t-on-click="() => this.openList('Auto-renewing soon', state.data.auto_renewing.domain)">
                        <div class="o_cr_card_label">Auto-renewing soon (60 days)</div>
                        <div class="o_cr_card_number" t-esc="state.data.auto_renewing.count"/>
                        <div class="o_cr_card_sub"><t t-esc="state.data.auto_renewing.value"/> to renew</div>
                    </div>
                    <div class="o_cr_card o_cr_card_warning" t-if="state.data.bill_flags"
                         t-on-click="() => this.openList('Bill issues', state.data.bill_flags.domain)">
                        <div class="o_cr_card_label">Bill issues</div>
                        <div class="o_cr_card_number o_cr_money" t-esc="state.data.bill_flags.value"/>
                        <div class="o_cr_card_sub">
                            <t t-esc="state.data.bill_flags.count"/> contract(s) billed above the agreed price or missing a bill
                        </div>
                    </div>
                    <div class="o_cr_card o_cr_card_primary" t-on-click="() => this.openForecast()">
                        <div class="o_cr_card_label">12-month commitment</div>
                        <div class="o_cr_card_number o_cr_money" t-esc="state.data.commitment.value"/>
                        <div class="o_cr_card_sub">Projected payments this month onwards</div>
                    </div>
                    <div class="o_cr_card o_cr_card_success" t-on-click="() => this.openList('Saved (last 12 months)', state.data.savings.domain)">
                        <div class="o_cr_card_label">Saved (last 12 months)</div>
                        <div class="o_cr_card_number o_cr_money" t-esc="state.data.savings.value"/>
                        <div class="o_cr_card_sub">
                            <t t-esc="state.data.savings.count"/> contract(s) cancelled or renegotiated
                        </div>
                    </div>
                    <div class="o_cr_card o_cr_card_danger" t-on-click="() => this.openList('Money at risk', state.data.money_at_risk.domain)">
                        <div class="o_cr_card_label">Money at risk</div>
                        <div class="o_cr_card_number o_cr_money" t-esc="state.data.money_at_risk.value"/>
                        <div class="o_cr_card_sub">
                            <t t-esc="state.data.money_at_risk.count"/> auto-renewal(s) with a cancel deadline in 30 days
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-lg-7 mb-3">
                        <div class="o_cr_panel">
                            <h5 class="o_cr_panel_title">Needs action (next 30 days)</h5>
                            <div t-if="!state.data.alerts.length" class="text-muted p-3">
                                Nothing needs your attention in the next 30 days.
                            </div>
                            <t t-foreach="state.data.alerts" t-as="alert" t-key="alert.id">
                                <div class="o_cr_alert" t-on-click="() => this.openRecord(alert.id)">
                                    <span t-attf-class="badge {{ this.urgencyClass(alert.urgency) }} me-2" t-esc="alert.days + 'd'"/>
                                    <span class="o_cr_alert_text" t-esc="alert.text"/>
                                    <span class="text-muted ms-2" t-if="alert.partner" t-esc="alert.partner"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="col-lg-5 mb-3">
                        <div class="o_cr_panel">
                            <h5 class="o_cr_panel_title">Next 12 months (costs)</h5>
                            <div class="o_cr_bars">
                                <t t-foreach="state.data.commitment.months" t-as="bar" t-key="bar_index">
                                    <div class="o_cr_bar_col" t-att-title="bar.display">
                                        <div class="o_cr_bar_wrap">
                                            <div class="o_cr_bar" t-attf-style="height: {{ bar.pct }}%;"/>
                                        </div>
                                        <div class="o_cr_bar_label" t-esc="bar.label"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7 mb-3">
                        <div class="o_cr_panel">
                            <h5 class="o_cr_panel_title">Active contracts by type</h5>
                            <table class="table table-sm mb-0" t-if="state.data.by_type.length">
                                <thead><tr><th>Type</th><th class="text-end">Contracts</th><th class="text-end">Annual value</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.by_type" t-as="row" t-key="row.key" class="o_cr_row"
                                        t-on-click="() => this.openList(row.label, row.domain)">
                                        <td t-esc="row.label"/>
                                        <td class="text-end" t-esc="row.count"/>
                                        <td class="text-end" t-esc="row.value"/>
                                    </tr>
                                </tbody>
                            </table>
                            <div t-else="" class="text-muted p-3">No active contracts yet.</div>
                        </div>
                    </div>
                    <div class="col-lg-5 mb-3">
                        <div class="o_cr_panel">
                            <h5 class="o_cr_panel_title">Housekeeping</h5>
                            <div class="o_cr_flag" t-if="state.data.flags.pending_decisions.count"
                                 t-on-click="() => this.openList('Decisions waiting', state.data.flags.pending_decisions.domain)">
                                <span class="badge text-bg-warning me-2" t-esc="state.data.flags.pending_decisions.count"/>renewal decisions waiting for approval
                            </div>
                            <div class="o_cr_flag" t-on-click="() => this.openList('No owner', state.data.flags.no_owner.domain)">
                                <span class="badge text-bg-secondary me-2" t-esc="state.data.flags.no_owner.count"/>contracts with no responsible user
                            </div>
                            <div class="o_cr_flag" t-on-click="() => this.openList('No end date', state.data.flags.no_end.domain)">
                                <span class="badge text-bg-secondary me-2" t-esc="state.data.flags.no_end.count"/>contracts with no end date
                            </div>
                            <div class="o_cr_flag" t-on-click="() => this.openList('Confidential', state.data.flags.confidential.domain)">
                                <span class="badge text-bg-secondary me-2" t-esc="state.data.flags.confidential.count"/>confidential contracts
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Layout>
    </div>

</templates>
