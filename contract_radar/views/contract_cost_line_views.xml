<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_cost_line_view_form" model="ir.ui.view">
        <field name="name">contract.radar.cost.line.form</field>
        <field name="model">contract.radar.cost.line</field>
        <field name="arch" type="xml">
            <form string="Projected Payment" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Payment" name="payment">
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="flow"/>
                        </group>
                        <group string="Amount" name="amount">
                            <field name="amount"/>
                            <field name="amount_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Contract" name="contract_info">
                        <group>
                            <field name="contract_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_cost_line_view_pivot" model="ir.ui.view">
        <field name="name">contract.radar.cost.line.pivot</field>
        <field name="model">contract.radar.cost.line</field>
        <field name="arch" type="xml">
            <pivot string="Commitment Forecast" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="contract_type" type="col"/>
                <field name="amount_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="contract_cost_line_view_graph" model="ir.ui.view">
        <field name="name">contract.radar.cost.line.graph</field>
        <field name="model">contract.radar.cost.line</field>
        <field name="arch" type="xml">
            <graph string="Commitment Forecast" type="bar" stacked="True" sample="1">
                <field name="date" interval="month"/>
                <field name="contract_type"/>
                <field name="amount_company" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="contract_cost_line_view_list" model="ir.ui.view">
        <field name="name">contract.radar.cost.line.list</field>
        <field name="model">contract.radar.cost.line</field>
        <field name="arch" type="xml">
            <list string="Projected Payments" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_company" sum="Total"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="contract_cost_line_view_search" model="ir.ui.view">
        <field name="name">contract.radar.cost.line.search</field>
        <field name="model">contract.radar.cost.line</field>
        <field name="arch" type="xml">
            <search string="Projected Payments">
                <field name="contract_id"/>
                <field name="partner_id"/>
                <filter name="filter_commitments" string="Costs (Active &amp; Expiring)"
                        domain="[('flow', '=', 'cost'), ('state', 'in', ('active', 'expiring'))]"/>
                <filter name="filter_revenue" string="Revenue (Active &amp; Expiring)"
                        domain="[('flow', '=', 'revenue'), ('state', 'in', ('active', 'expiring'))]"/>
                <separator/>
                <filter name="filter_next12" string="Next 12 Months"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;', (context_today() + relativedelta(months=12)).strftime('%Y-%m-01'))]"/>
                <group>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'contract_type'}"/>
                    <filter name="group_partner" string="Counterparty" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_contract_cost_line" model="ir.actions.act_window">
        <field name="name">Commitment Forecast</field>
        <field name="res_model">contract.radar.cost.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_filter_commitments': 1, 'search_default_filter_next12': 1}</field>
        <field name="search_view_id" ref="contract_cost_line_view_search"/>
    </record>
</odoo>
