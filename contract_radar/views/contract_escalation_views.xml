<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_radar_amendment_view_list" model="ir.ui.view">
        <field name="name">contract.radar.amendment.list</field>
        <field name="model">contract.radar.amendment</field>
        <field name="arch" type="xml">
            <list string="Amendments">
                <field name="date"/>
                <field name="contract_id"/>
                <field name="name"/>
                <field name="new_date_end"/>
                <field name="new_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="applied"/>
            </list>
        </field>
    </record>

    <record id="contract_radar_amendment_view_form" model="ir.ui.view">
        <field name="name">contract.radar.amendment.form</field>
        <field name="model">contract.radar.amendment</field>
        <field name="arch" type="xml">
            <form string="Amendment">
                <header>
                    <button name="action_apply" type="object" string="Apply to Contract" class="btn-primary" invisible="applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="new_date_end"/>
                            <field name="new_amount"/>
                        </group>
                        <group>
                            <field name="applied"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>
                    <field name="summary" placeholder="What changed and why..."/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
