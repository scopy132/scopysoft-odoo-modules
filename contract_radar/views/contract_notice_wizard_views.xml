<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_notice_wizard_view_form" model="ir.ui.view">
        <field name="name">contract.radar.notice.wizard.form</field>
        <field name="model">contract.radar.notice.wizard</field>
        <field name="arch" type="xml">
            <form string="Serve Notice">
                <field name="contract_id" invisible="1"/>
                <group>
                    <field name="generate_letter"/>
                    <field name="send_email" invisible="not generate_letter"/>
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"
                           invisible="not generate_letter or not send_email"/>
                    <field name="subject" invisible="not generate_letter"/>
                </group>
                <field name="body" invisible="not generate_letter"/>
                <p class="text-muted" invisible="not generate_letter">
                    The letter is saved as a PDF in the contract documents and posted in the chatter.
                </p>
                <footer>
                    <button name="action_confirm" string="Serve Notice" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
