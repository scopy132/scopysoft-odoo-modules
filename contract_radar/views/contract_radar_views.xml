<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================ FORM ============================ -->
    <record id="contract_radar_view_form" model="ir.ui.view">
        <field name="name">contract.radar.form</field>
        <field name="model">contract.radar</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary"
                            invisible="state != 'draft' or is_template"/>
                    <button name="action_renew" string="Renew" type="object" class="btn-primary"
                            invisible="state not in ('active', 'expiring')"
                            confirm="This creates the next-term contract with any price increase applied and marks this one as Renewed. Continue?"/>
                    <button name="action_open_notice_wizard" string="Serve Notice" type="object"
                            invisible="state not in ('active', 'expiring') or not auto_renew or notice_sent_date"/>
                    <button name="action_submit_decision" string="Submit Decision" type="object"
                            invisible="is_template or state not in ('active', 'expiring') or decision_state not in ('none', 'rejected') or not decision"/>
                    <button name="action_approve_decision" string="Approve Decision" type="object" class="btn-primary"
                            invisible="decision_state != 'pending'" groups="contract_radar.group_contract_manager"/>
                    <button name="action_reject_decision" string="Reject Decision" type="object"
                            invisible="decision_state != 'pending'" groups="contract_radar.group_contract_manager"/>
                    <button name="action_cancel" string="Cancel Contract" type="object"
                            invisible="state in ('draft', 'cancelled', 'expired', 'renewed')"
                            confirm="Cancel this contract?"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expiring,renewed"
                           invisible="is_template"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-paperclip"
                                invisible="is_template">
                            <field name="attachment_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_amendments" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="is_template">
                            <field name="amendment_count" widget="statinfo" string="Amendments"/>
                        </button>
                        <button name="action_view_renewals" type="object" class="oe_stat_button" icon="fa-refresh"
                                invisible="is_template or (renewal_count == 0 and not renewed_from_id)">
                            <field name="renewal_count" widget="statinfo" string="Renewals"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Template" bg_color="text-bg-info" invisible="not is_template"/>
                    <field name="active" invisible="1"/>
                    <field name="is_template" invisible="1"/>
                    <field name="urgency" invisible="1"/>
                    <field name="will_renew" invisible="1"/>
                    <field name="renewed_from_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="decision_state" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="decision_state != 'approved' or decision != 'cancel' or not auto_renew or notice_sent_date or state not in ('active', 'expiring')">
                        <i class="fa fa-info-circle me-1"/>Cancellation approved. Serve notice before the deadline so this contract does not renew.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="decision_state != 'pending'">
                        <i class="fa fa-hourglass-half me-1"/>A renewal decision is waiting for a manager's approval.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="urgency not in ('urgent', 'overdue') or not alert_text">
                        <i class="fa fa-exclamation-triangle me-1"/><field name="alert_text" class="fw-bold" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="urgency != 'soon' or not alert_text">
                        <i class="fa fa-bell me-1"/><field name="alert_text" class="fw-bold" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Head office lease, Microsoft 365 licences"/></h1>
                        <h3 class="text-muted"><field name="reference"/></h3>
                    </div>
                    <group>
                        <group name="left" string="Parties">
                            <field name="template_id" invisible="is_template or state != 'draft'" options="{'no_create': True}"/>
                            <field name="contract_type"/>
                            <field name="partner_id" required="not is_template"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="backup_user_id" widget="many2one_avatar_user"/>
                            <field name="visibility"/>
                            <field name="kanban_state" widget="state_selection" invisible="is_template"/>
                        </group>
                        <group name="right" string="Deadlines">
                            <field name="date_start" required="not is_template"/>
                            <field name="date_end"/>
                            <field name="notice_days"/>
                            <field name="cancel_by_business_day"/>
                            <field name="date_cancel_by" class="fw-bold fs-4" invisible="not date_end"/>
                            <field name="cancel_countdown" widget="badge" decoration-danger="urgency in ('urgent', 'overdue')" decoration-warning="urgency == 'soon'" decoration-success="urgency == 'ok'" invisible="not date_cancel_by"/>
                            <field name="cancel_by_note" nolabel="1" colspan="2" class="text-muted small"
                                   invisible="not cancel_by_note"/>
                            <field name="auto_renew"/>
                            <field name="notice_sent_date" invisible="not auto_renew and not notice_sent_date"/>
                            <field name="renewal_term_months" invisible="state in ('renewed', 'cancelled', 'expired')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pricing &amp; Escalation" name="pricing">
                            <group>
                                <group string="Price">
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                    <field name="billing_period"/>
                                    <field name="amount"/>
                                    <field name="annual_value"/>
                                    <field name="renewal_amount" invisible="is_template"/>
                                    <field name="projected_total" invisible="is_template"/>
                                    <field name="flow"/>
                                </group>
                                <group string="Price Escalation">
                                    <field name="escalation_mode"/>
                                    <field name="escalation_percent" invisible="escalation_mode != 'fixed_percent'"/>
                                    <field name="escalation_every_months" invisible="escalation_mode != 'fixed_percent'"/>
                                    <field name="escalation_clause" nolabel="1" colspan="2"
                                           placeholder="Paste the price increase clause here (e.g. 'annual increase of 7% on each anniversary')"/>
                                </group>
                            </group>
                            <field name="escalation_ids" invisible="escalation_mode != 'scheduled'">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="step_type"/>
                                    <field name="value"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="resulting_amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details" name="details">
                            <group>
                                <group>
                                    <field name="external_ref" invisible="is_template"/>
                                    <field name="asset_ref" invisible="contract_type not in ('lease', 'warranty', 'license', 'service')"/>
                                    <field name="license_seats" invisible="contract_type != 'license'"/>
                                    <field name="term_months"/>
                                    <field name="is_template" string="Use as Template" groups="contract_radar.group_contract_manager"/>
                                </group>
                                <group>
                                    <field name="reminder_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="Renewal Decision" name="decision"
                              invisible="is_template or state in ('draft',)">
                            <group>
                                <group>
                                    <field name="decision_state" widget="badge"
                                           decoration-warning="decision_state == 'pending'"
                                           decoration-success="decision_state == 'approved'"
                                           decoration-danger="decision_state == 'rejected'"/>
                                    <field name="decision" readonly="decision_state in ('pending', 'approved')"/>
                                    <field name="decision_new_amount" invisible="decision != 'renegotiate'"
                                           readonly="decision_state in ('pending', 'approved')"/>
                                    <field name="decision_baseline_amount" invisible="decision_state == 'none'"/>
                                    <field name="saving_amount" invisible="decision_state != 'approved'"/>
                                </group>
                                <group>
                                    <field name="decision_requested_by_id" invisible="decision_state == 'none'"
                                           widget="many2one_avatar_user"/>
                                    <field name="decision_approver_id" invisible="decision_state not in ('approved', 'rejected')"
                                           widget="many2one_avatar_user"/>
                                    <field name="decision_date" invisible="decision_state != 'approved'"/>
                                </group>
                            </group>
                            <field name="decision_reason" placeholder="Why renew, renegotiate or cancel?"
                                   readonly="decision_state in ('pending', 'approved')"/>
                            <button name="action_reset_decision" string="Reset Decision" type="object"
                                    class="btn-secondary mt-2"
                                    invisible="decision_state in ('none', 'pending')"
                                    groups="contract_radar.group_contract_manager"
                                    confirm="Clear this decision so a new one can be made?"/>
                        </page>
                        <page string="Notice Letter" name="notice_letter" invisible="not notice_body">
                            <field name="notice_body" readonly="1"/>
                        </page>
                        <page string="Amendments" name="amendments" invisible="is_template">
                            <field name="amendment_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="new_date_end" optional="show"/>
                                    <field name="new_amount" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="applied" widget="boolean" optional="show"/>
                                    <button name="action_apply" type="object" string="Apply" icon="fa-check"
                                            invisible="applied"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="date"/>
                                            <field name="currency_id" invisible="1"/>
                                            <field name="new_date_end"/>
                                            <field name="new_amount"/>
                                        </group>
                                        <group>
                                            <field name="applied"/>
                                            <field name="attachment_ids" widget="many2many_binary"/>
                                        </group>
                                    </group>
                                    <field name="summary" placeholder="What changed and why..."/>
                                </form>
                            </field>
                        </page>
                        <page string="Projected Payments" name="payments" invisible="is_template">
                            <field name="cost_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_company"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reminders" name="reminders" invisible="is_template">
                            <field name="reminder_log_ids" readonly="1">
                                <list>
                                    <field name="sent_on"/>
                                    <field name="stage_days"/>
                                    <field name="anchor_date"/>
                                    <field name="notified"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Notes" name="terms">
                            <field name="terms" placeholder="Key terms, SLAs, special conditions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================ LIST ============================ -->
    <record id="contract_radar_view_list" model="ir.ui.view">
        <field name="name">contract.radar.list</field>
        <field name="model">contract.radar</field>
        <field name="arch" type="xml">
            <list string="Contracts"
                  decoration-danger="urgency in ('urgent', 'overdue')"
                  decoration-warning="urgency == 'soon'"
                  decoration-muted="state in ('cancelled', 'expired', 'renewed')">
                <field name="reference"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type" widget="badge"/>
                <field name="date_end"/>
                <field name="date_cancel_by" string="Cancel By"/>
                <field name="cancel_countdown" string="Countdown" widget="badge" decoration-danger="urgency in ('urgent', 'overdue')" decoration-warning="urgency == 'soon'" decoration-success="urgency == 'ok'"/>
                <field name="auto_renew" optional="show"/>
                <field name="notice_days" optional="hide"/>
                <field name="amount" widget="monetary"/>
                <field name="annual_value" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="True" groups="base.group_multi_currency"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="urgency" widget="badge"
                       decoration-danger="urgency in ('urgent', 'overdue')"
                       decoration-warning="urgency == 'soon'"
                       decoration-success="urgency == 'ok'"
                       optional="hide"/>
                <field name="kanban_state" widget="state_selection" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state in ('cancelled', 'expired')"/>
                <field name="is_template" column_invisible="True"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============================ KANBAN ============================ -->
    <record id="contract_radar_view_kanban" model="ir.ui.view">
        <field name="name">contract.radar.kanban</field>
        <field name="model">contract.radar</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" group_create="false" quick_create="false">
                <field name="currency_id"/>
                <field name="urgency"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline mb-1">
                            <field name="name" class="fw-bold fs-5 me-2"/>
                            <field name="amount" widget="monetary" class="fw-bold ms-auto flex-shrink-0"/>
                        </div>
                        <div class="text-muted mb-1">
                            <field name="partner_id"/>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-1">
                            <field name="contract_type" widget="badge"/>
                            <field name="urgency" widget="badge"
                                   invisible="urgency == 'none'"
                                   decoration-danger="urgency in ('urgent', 'overdue')"
                                   decoration-warning="urgency == 'soon'"
                                   decoration-success="urgency == 'ok'"/>
                        </div>
                        <div class="small" invisible="not date_cancel_by">
                            <span class="text-muted">Cancel by: </span>
                            <field name="date_cancel_by"/>
                            <field name="cancel_countdown" widget="badge" decoration-danger="urgency in ('urgent', 'overdue')" decoration-warning="urgency == 'soon'" decoration-success="urgency == 'ok'" class="ms-1"/>
                        </div>
                        <footer class="pt-1">
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="kanban_state" widget="state_selection" class="ms-auto me-1"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================ SEARCH ============================ -->
    <record id="contract_radar_view_search" model="ir.ui.view">
        <field name="name">contract.radar.search</field>
        <field name="model">contract.radar</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name" string="Contract" filter_domain="['|', '|', ('name', 'ilike', self), ('reference', 'ilike', self), ('external_ref', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                <filter name="filter_live" string="Active &amp; Expiring" domain="[('state', 'in', ('active', 'expiring'))]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="filter_cancel_30" string="Cancel By: Next 30 Days"
                        domain="[('state', 'in', ('active', 'expiring')), ('date_cancel_by', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_cancel_by', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_exp_30" string="Expiring in 30 Days"
                        domain="[('state', 'in', ('active', 'expiring')), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_exp_60" string="Expiring in 60 Days"
                        domain="[('state', 'in', ('active', 'expiring')), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_exp_90" string="Expiring in 90 Days"
                        domain="[('state', 'in', ('active', 'expiring')), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_auto_renew" string="Auto-Renewing" domain="[('will_renew', '=', True)]"/>
                <filter name="filter_decision_pending" string="Decision Waiting for Approval"
                        domain="[('decision_state', '=', 'pending')]"/>
                <filter name="filter_saved" string="With Approved Savings"
                        domain="[('decision_state', '=', 'approved'), ('saving_amount', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_my" string="My Contracts" domain="['|', ('user_id', '=', uid), ('backup_user_id', '=', uid)]"/>
                <filter name="filter_no_owner" string="No Owner" domain="[('user_id', '=', False)]"/>
                <filter name="filter_no_end" string="No End Date" domain="[('date_end', '=', False)]"/>
                <filter name="filter_confidential" string="Confidential" domain="[('visibility', '=', 'followers')]"/>
                <separator/>
                <filter name="filter_cost" string="Costs" domain="[('flow', '=', 'cost')]"/>
                <filter name="filter_revenue" string="Revenue" domain="[('flow', '=', 'revenue')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'contract_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Counterparty" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_end" string="End Date" context="{'group_by': 'date_end:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================ ACTIONS ============================ -->
    <record id="action_contract_radar" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">contract.radar</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_template', '=', False)]</field>
        <field name="context">{'search_default_filter_live': 1}</field>
        <field name="search_view_id" ref="contract_radar_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first contract</p>
            <p>Track vendor, customer, lease, warranty and license contracts. The radar warns you before an
               auto-renewal slips past its cancellation deadline.</p>
        </field>
    </record>

    <record id="action_contract_radar_template" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">contract.radar</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_template', '=', True)]</field>
        <field name="context">{'default_is_template': True}</field>
        <field name="search_view_id" ref="contract_radar_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a contract template</p>
            <p>Templates pre-fill type, pricing, notice period, escalation and reminder settings on new contracts.</p>
        </field>
    </record>
</odoo>
