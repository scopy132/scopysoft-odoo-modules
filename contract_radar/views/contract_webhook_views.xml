<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_webhook_view_list" model="ir.ui.view">
        <field name="name">contract.radar.webhook.list</field>
        <field name="model">contract.radar.webhook</field>
        <field name="arch" type="xml">
            <list string="Notification Webhooks">
                <field name="name"/>
                <field name="payload_format"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="on_reminder" optional="show"/>
                <field name="on_notice" optional="show"/>
                <field name="on_decision" optional="show"/>
                <field name="last_sent"/>
                <field name="last_status"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="contract_webhook_view_form" model="ir.ui.view">
        <field name="name">contract.radar.webhook.form</field>
        <field name="model">contract.radar.webhook</field>
        <field name="arch" type="xml">
            <form string="Notification Webhook">
                <header>
                    <button name="action_send_test" string="Send Test Message" type="object" class="btn-primary"
                            invisible="not id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="Destination">
                            <field name="name"/>
                            <field name="url" password="True" placeholder="https://hooks.slack.com/services/..."/>
                            <field name="payload_format"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Send a message when">
                            <field name="on_reminder"/>
                            <field name="on_notice"/>
                            <field name="on_decision"/>
                        </group>
                    </group>
                    <group string="Last delivery" invisible="not last_sent">
                        <field name="last_sent"/>
                        <field name="last_status"/>
                    </group>
                    <p class="text-muted">
                        Messages never include confidential contracts. A webhook that fails is skipped and never
                        blocks a reminder or a user.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contract_webhook" model="ir.actions.act_window">
        <field name="name">Notification Webhooks</field>
        <field name="res_model">contract.radar.webhook</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Send deadline alerts to Slack, Google Chat, Discord or Teams</p>
            <p>Paste a webhook address and the radar posts a short message for reminders, served notices and
               approved decisions.</p>
        </field>
    </record>
</odoo>
