<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_multi_product" model="ir.ui.view">
        <field name="name">mrp.production.form.multi.product.pro</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Pro's entry points live together next to Mark as Done, so
                 they read as one cohesive "Pro" tool rather than a loose
                 scatter of extra buttons. -->
            <xpath expr="//button[@name='button_mark_done']" position="before">
                <button name="action_add_products" type="object"
                        string="Add Products" icon="fa-magic"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'confirmed')"/>
                <button name="action_pull_from_sale_order" type="object"
                        string="Pull from Sales Order" icon="fa-shopping-cart"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'confirmed')"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_multi_product_cost_breakdown" type="object"
                        class="oe_stat_button" icon="fa-pie-chart"
                        invisible="not has_multi_products">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="multi_product_total_cost" widget="monetary" nolabel="1"/>
                        </span>
                        <span class="o_stat_text" invisible="state == 'done'">Est. Batch Cost</span>
                        <span class="o_stat_text" invisible="state != 'done'">Products Cost</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='product_id']/ancestor::group[2]" position="after">
                <div class="text-muted mb-2" invisible="total_products_count &lt;= 1">
                    <field name="total_products_count" invisible="1"/>
                    <field name="multi_product_overall_status" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="multi_product_has_standard_cost_product" invisible="1"/>
                    <span class="badge rounded-pill text-bg-success" invisible="multi_product_overall_status != 'available'">Pro</span>
                    <span class="badge rounded-pill text-bg-warning" invisible="multi_product_overall_status != 'partial'">Pro</span>
                    <span class="badge rounded-pill text-bg-danger" invisible="multi_product_overall_status != 'unavailable'">Pro</span>
                    <field name="total_products_count" nolabel="1"/> products on this order — see the "Products" tab below.
                </div>
                <div class="alert alert-info py-1 px-2 mb-2" role="alert"
                     invisible="not multi_product_has_standard_cost_product">
                    One or more products on this order use "Standard Price" costing.
                    Odoo only splits real production cost across products on AVCO or
                    FIFO — on Standard Price, each product will be valued at its own
                    configured cost, not a share of this order's actual cost.
                </div>
                <div class="alert alert-warning py-1 px-2 mb-2" role="alert"
                     invisible="multi_product_overall_status == 'available' or total_products_count &lt;= 1">
                    <field name="multi_product_shortage_summary" nolabel="1"/>
                </div>
            </xpath>

            <xpath expr="//page[@name='components']/.." position="inside">
                <page string="Products" name="multi_products"
                      invisible="not has_multi_products and state == 'draft'">
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not multi_product_missing_bom">
                        One or more products below have no Bill of Materials selected
                        and will be produced with zero components. Set a BOM for each,
                        or confirm this is intentional.
                    </div>
                    <field name="multi_product_line_ids">
                        <list editable="bottom" create="0"
                              decoration-muted="state in ('done','cancel')">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="state in ('done','cancel')"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="state in ('done','cancel')"/>
                            <field name="bom_id" readonly="state in ('done','cancel')"/>
                            <field name="component_status" widget="badge"
                                   decoration-success="component_status == 'available'"
                                   decoration-warning="component_status == 'partial'"
                                   decoration-danger="component_status == 'unavailable'"/>
                            <field name="lot_producing_ids" widget="many2many_tags"
                                   invisible="product_tracking == 'none'"
                                   readonly="state in ('done','cancel')"/>
                            <button name="action_generate_serial" type="object"
                                    string="Generate" icon="fa-magic"
                                    invisible="product_tracking == 'none' or state in ('done','cancel')"/>
                            <field name="qty_done" string="Done"/>
                            <field name="sale_line_id" column_invisible="1"/>
                            <field name="product_tmpl_id" column_invisible="1"/>
                            <field name="product_tracking" column_invisible="1"/>
                        </list>
                    </field>
                    <p class="text-muted mt-2" invisible="state not in ('draft', 'confirmed')">
                        Use "Add Products" or "Pull from Sales Order" above to add more
                        products — the product itself can't be changed here once added,
                        only its quantity, unit of measure, BOM and lot/serial numbers.
                    </p>
                </page>
            </xpath>

            <!-- This module's own additional-product moves are deliberately
                 members of move_byproduct_ids (that's how native _cal_price
                 finds them and splits real production cost onto them) — but
                 they're already shown, editable, in the "Products" page
                 above. Left unfiltered, the native By-Products page would
                 list the same product a second time, which reads as if it's
                 being produced/costed twice even though it isn't. This
                 domain hides only OUR moves (byproduct_id is never set on
                 them — see mrp_production._allocate_multi_product_cost_shares)
                 from THIS page; a real, manually-configured byproduct
                 (byproduct_id set) still shows normally. The underlying
                 move_byproduct_ids field itself is untouched, so Valuation,
                 Overview and this module's own cost breakdown all keep
                 reading the full, correct set. -->
            <xpath expr="//page[@name='finished_products']/field[@name='move_byproduct_ids']"
                   position="attributes">
                <attribute name="domain">[('byproduct_id', '!=', False)]</attribute>
            </xpath>

        </field>
    </record>

    <!-- "N products" badge on the Manufacturing Orders list, so a
         multi-product MO is instantly scannable in a long list instead of
         looking identical to a single-product one. List views render each
         column as its own <field> — no wrapping <span>/<div> allowed —
         so this uses widget="badge" directly on the field itself. -->
    <record id="mrp_production_list_view_multi_product" model="ir.ui.view">
        <field name="name">mrp.production.list.multi.product.pro</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="total_products_count" string="Products"
                       widget="badge" optional="show"
                       decoration-info="total_products_count &gt; 1"
                       invisible="total_products_count &lt;= 1"/>
            </xpath>
        </field>
    </record>

    <!-- Same badge on the mobile kanban cards. This kanban uses the newer
         t-name="card" QWeb template style, so the badge is added as a plain
         span at the end of the footer (a safe, always-present anchor point)
         rather than guessing at a specific div class. -->
    <record id="mrp_production_kanban_view_multi_product" model="ir.ui.view">
        <field name="name">mrp.production.kanban.multi.product.pro</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="total_products_count" invisible="1"/>
            </xpath>
            <xpath expr="//footer" position="inside">
                <span class="badge text-bg-info ms-1"
                      t-if="record.total_products_count.raw_value &gt; 1">
                    <t t-esc="record.total_products_count.value"/> products
                </span>
            </xpath>
        </field>
    </record>
</odoo>
