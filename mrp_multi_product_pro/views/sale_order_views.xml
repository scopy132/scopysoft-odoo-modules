<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_multi_product_mo_button" model="ir.ui.view">
        <field name="name">sale.order.form.multi.product.mo.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_create_multi_product_mo" type="object"
                        string="Create Multi-Product MO" icon="fa-industry"
                        class="btn-secondary"
                        invisible="state != 'sale'"
                        help="Creates one Manufacturing Order covering every
                              manufacturable product on this order in one click,
                              and links it back here so it shows up under the
                              Manufacturing smart button above."/>
            </xpath>
        </field>
    </record>
</odoo>
