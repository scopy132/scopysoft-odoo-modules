<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_add_products_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.add.products.wizard.form</field>
        <field name="model">mrp.production.add.products.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Products to Manufacture">
                <p class="text-muted">
                    Pick as many products as you like — just like adding lines to a
                    Sales Order. Each one's Bill of Materials is auto-detected and its
                    components will merge into the combined Components list.
                </p>
                <field name="production_id" invisible="1"/>
                <group>
                    <field name="paste_text" nolabel="1"
                           placeholder="Paste a list, one product per line: reference or name, quantity&#10;e.g.&#10;FG-Widget-A, 5&#10;FG-Widget-B, 3"/>
                </group>
                <button name="action_parse_pasted_list" type="object"
                        string="Add pasted list below" icon="fa-clipboard"
                        class="btn-secondary mb-2"/>
                <field name="pick_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="product_qty"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                        <field name="bom_id"/>
                        <field name="product_tmpl_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Add to Manufacturing Order"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
