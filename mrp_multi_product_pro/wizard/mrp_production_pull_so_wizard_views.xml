<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_pull_so_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.pull.so.wizard.form</field>
        <field name="model">mrp.production.pull.so.wizard</field>
        <field name="arch" type="xml">
            <form string="Pull Products from a Sales Order">
                <p class="text-muted">
                    This Manufacturing Order isn't automatically linked to a
                    Sales Order, so pick one below.
                </p>
                <field name="production_id" invisible="1"/>
                <field name="sale_order_id"/>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Pull Products" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
