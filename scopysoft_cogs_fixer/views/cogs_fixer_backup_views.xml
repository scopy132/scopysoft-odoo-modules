<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backup Run List View -->
    <record id="view_cogs_fixer_backup_list" model="ir.ui.view">
        <field name="name">cogs.fixer.backup.list</field>
        <field name="model">cogs.fixer.backup</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="run_date" />
                <field name="user_id" />
                <field name="product_id" />
                <field name="svl_count" />
                <field name="line_count" />
            </tree>
        </field>
    </record>

    <!-- Backup Run Form View -->
    <record id="view_cogs_fixer_backup_form" model="ir.ui.view">
        <field name="name">cogs.fixer.backup.form</field>
        <field name="model">cogs.fixer.backup</field>
        <field name="arch" type="xml">
            <form string="COGS Fixer Backup">
                <div class="alert alert-info" role="alert">
                    This is a log of what the COGS Fixer changed - it does not support one-click restore.
                    If something needs to be reverted, test your fix in a duplicate database first; use the
                    lines below as the record of exactly what each journal entry looked like beforehand.
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="run_date" />
                            <field name="user_id" />
                            <field name="company_id" />
                        </group>
                        <group>
                            <field name="product_id" />
                            <field name="svl_count" />
                            <field name="line_count" />
                        </group>
                    </group>
                    <field name="notes" />
                    <notebook>
                        <page string="Backed Up Journal Lines">
                            <field name="line_ids">
                                <tree>
                                    <field name="product_id" />
                                    <field name="account_move_id" />
                                    <field name="account_id" />
                                    <field name="line_name" />
                                    <field name="debit" />
                                    <field name="credit" />
                                    <field name="was_pre_existing" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cogs_fixer_backup" model="ir.actions.act_window">
        <field name="name">COGS Fixer Backups</field>
        <field name="res_model">cogs.fixer.backup</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_cogs_fixer_backup"
        name="COGS Fixer Backups"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_cogs_fixer_backup"
        sequence="103" />
</odoo>
