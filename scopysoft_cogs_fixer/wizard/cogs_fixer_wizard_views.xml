<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_cogs_fixer_wizard_form" model="ir.ui.view">
        <field name="name">cogs.fixer.wizard.form</field>
        <field name="model">cogs.fixer.wizard</field>
        <field name="arch" type="xml">
            <form string="COGS Fixer">
                <group>
                    <group>
                        <field name="state" invisible="1" />
                        <field name="product_id" attrs="{'readonly': [('state', 'in', ['processing', 'done'])]}" />
                        <field name="dry_run" attrs="{'readonly': [('state', 'in', ['processing', 'done'])]}" />
                        <field name="batch_size" attrs="{'readonly': [('state', 'in', ['processing', 'done'])]}" />
                        <field name="create_backup" attrs="{'readonly': [('state', 'in', ['processing', 'done'])]}" />
                    </group>
                </group>

                <group string="Filters (optional)">
                    <field name="date_from" attrs="{'readonly': [('state', 'in', ['processing', 'done'])]}" />
                    <field name="date_to" attrs="{'readonly': [('state', 'in', ['processing', 'done'])]}" />
                </group>

                <notebook attrs="{'invisible': [('state', '=', 'draft')]}">
                    <page string="Progress Log" attrs="{'invisible': [('progress_log', '=', False)]}">
                        <field name="progress_log" nolabel="1"
                            widget="text"
                            style="font-family: monospace; white-space: pre-wrap; background-color: #f5f5f5; padding: 10px;" />
                    </page>
                    <page string="Results" attrs="{'invisible': [('result_message', '=', False)]}">
                        <field name="result_message" nolabel="1" />
                        <group attrs="{'invisible': [('state', '=', 'draft')]}">
                            <field name="csv_export_filename" invisible="1" />
                            <field name="csv_export" filename="csv_export_filename" string="Download CSV Report" />
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_run_fixer"
                        string="Run Fixer"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', 'in', ['processing', 'done'])]}" />
                    <button name="action_reset"
                        string="Reset"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'draft')]}" />
                    <field name="backup_id" invisible="1" />
                    <button name="action_view_backup"
                        string="View Backup"
                        type="object"
                        attrs="{'invisible': ['|', ('state', '=', 'draft'), ('backup_id', '=', False)]}" />
                    <button string="Close" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_cogs_fixer_wizard" model="ir.actions.act_window">
        <field name="name">Fix COGS Journal Entries</field>
        <field name="res_model">cogs.fixer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_cogs_fixer_wizard"
        name="Fix COGS Journal Entries"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_cogs_fixer_wizard"
        sequence="100" />
</odoo>