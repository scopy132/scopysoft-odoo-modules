<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_svl_fixer_wizard_form" model="ir.ui.view">
        <field name="name">svl.fixer.wizard.form</field>
        <field name="model">svl.fixer.wizard</field>
        <field name="arch" type="xml">
            <form string="SVL Quantity Fixer">
                <group>
                    <group>
                        <field name="state" invisible="1" />
                        <field name="process_all_products" attrs="{'readonly': [('state', '=', 'done')]}" />
                        <field name="product_tmpl_ids" widget="many2many_tags"
                            attrs="{'readonly': [('state', '=', 'done')], 'invisible': [('process_all_products', '=', True)], 'required': [('process_all_products', '=', False)]}" />
                        <field name="dry_run" attrs="{'readonly': [('state', '=', 'done')]}" />
                    </group>
                    <group>
                        <field name="batch_size" attrs="{'readonly': [('state', '=', 'done')]}" />
                        <field name="create_backup" attrs="{'readonly': [('state', '=', 'done')]}" />
                    </group>
                </group>

                <div class="alert alert-warning" role="alert"
                    attrs="{'invisible': ['|', ('cost_source', '!=', 'custom'), ('process_all_products', '=', False)]}">
                    A custom cost can't be used with "Process All Products" - untick it and pick specific products, or switch back to "Use Current Product Cost".
                </div>

                <group string="Cost Source">
                    <field name="cost_source"
                        widget="radio"
                        attrs="{'readonly': [('state', '=', 'done')]}" />
                    <field name="custom_cost"
                        attrs="{'invisible': [('cost_source', '!=', 'custom')], 'required': [('cost_source', '=', 'custom')], 'readonly': [('state', '=', 'done')]}" />
                </group>

                <group string="Filters (optional)">
                    <group>
                        <field name="date_from" attrs="{'readonly': [('state', '=', 'done')]}" />
                        <field name="date_to" attrs="{'readonly': [('state', '=', 'done')]}" />
                    </group>
                    <group>
                        <field name="min_unit_cost_delta" attrs="{'readonly': [('state', '=', 'done')]}" />
                    </group>
                </group>

                <notebook attrs="{'invisible': [('state', '=', 'draft')]}">
                    <page string="Results">
                        <field name="result_message" nolabel="1" />
                        <group attrs="{'invisible': [('state', '=', 'draft')]}">
                            <field name="csv_export_filename" invisible="1" />
                            <field name="csv_export" filename="csv_export_filename" string="Download CSV Report" />
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button name="action_run_fixer"
                        string="Run Fixer"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '=', 'done')]}" />
                    <button name="action_reset"
                        string="Reset"
                        type="object"
                        attrs="{'invisible': [('state', '=', 'draft')]}" />
                    <field name="backup_id" invisible="1" />
                    <button name="action_view_backup"
                        string="View Backup"
                        type="object"
                        attrs="{'invisible': ['|', ('state', '=', 'draft'), ('backup_id', '=', False)]}" />
                    <button string="Close" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_svl_fixer_wizard" model="ir.actions.act_window">
        <field name="name">Fix SVL Quantities</field>
        <field name="res_model">svl.fixer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_svl_fixer_wizard"
        name="Fix SVL Quantities"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_svl_fixer_wizard"
        sequence="101" />
</odoo>